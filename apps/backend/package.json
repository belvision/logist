{
  "name": "@logistic-pro/backend",
  "version": "1.0.0",
  "description": "Logistic Pro Backend API",
  "main": "dist/api/index.js",
  "scripts": {
    "dev": "tsx watch src/api/index.ts",
    "build": "tsc",
    "start": "node dist/api/index.js",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "check-all": "npm run type-check && npm run lint",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit push:pg",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:check": "drizzle-kit check:pg",
    "db:create": "tsx src/db/createDatabase.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/swagger-ui": "^0.5.2",
    "@types/crypto-js": "^4.2.2",
    "@types/nodemailer": "^7.0.1",
    "@types/pdfkit": "^0.17.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "drizzle-kit": "^0.20.0",
    "drizzle-orm": "^0.29.0",
    "google-auth-library": "^9.15.1",
    "hono": "^4.0.0",
    "isomorphic-dompurify": "^2.28.0",
    "jsonwebtoken": "REDACTED_SECRET",
    "minio": "^8.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.6",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "postgres": "^3.4.7",
    "puppeteer": "^24.23.0",
    "qrcode": "^1.5.4",
    "undici": "^7.16.0",
    "ws": "^8.14.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "REDACTED_SECRET",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "hono",
    "api",
    "postgresql",
    "typescript"
  ],
  "author": "",
  "license": "ISC"
}
