# Database (используйте .env локально и НЕ коммитьте реальные данные)
# Предпочтительно указывать DB_URL; DATABASE_URL остаётся как fallback
DB_URL=postgresql://DB_USER:DB_PASSWORD@0.0.0.0:5432/logistic_pro
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@0.0.0.0:5432/logistic_pro
DB_HOST=0.0.0.0
DB_PORT=5432
DB_NAME=logistic_pro
DB_USER=DB_USER
DB_PASSWORD=REDACTED_SECRET

# Server
# Порт API (документация доступна на http://0.0.0.0:5555/docs)
PORT=5555
NODE_ENV=development
CORS_ORIGIN=http://0.0.0.0:3000
FRONTEND_BASE_URL=http://0.0.0.0:3000

# Postgres (optional granular config if not using DB_URL)
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_DB=logistic_pro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REDACTED_SECRET

# JWT Authentication
# Задайте длинный случайный ключ в реальном .env
JWT_SECRET=REDACTED_SECRET
JWT_EXPIRES_IN=7d

# MFA
MFA_ISSUER=LogistGo
MFA_TOTP_WINDOW=1
MFA_RECOVERY_CODES_COUNT=10
MFA_TRUSTED_DEVICE_DAYS=30
# Ровно 32 байта (пример-заглушка)
MFA_ENCRYPTION_KEY=please_change_this_32bytes_key________
MFA_PENDING_SECRET=REDACTED_SECRET

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP (optional, для реальной отправки писем). Заполните в локальном .env
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Logistic Pro" <no-reply@local>

# Bitrix24 Integration
BITRIX24_URL=https://your-portal.bitrix24.by/rest/1/REDACTED_SECRET/
BITRIX24_WEBHOOK_TOKEN=your-webhook-token-here